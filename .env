# --- Telegram API Credentials (my.telegram.org से प्राप्त करें) ---
API_ID = 1234567
API_HASH = "your_api_hash_here"

# --- Bot Credentials (BotFather से प्राप्त करें) ---
BOT_TOKEN = "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"

# --- Owner & Admin Settings ---
# आपकी टेलीग्राम यूजर आईडी (बॉट के मालिक के रूप में)
OWNER_ID = 123456789

# --- Database Settings (MongoDB के लिए) ---
# MongoDB कनेक्शन स्ट्रिंग (MongoDB Atlas से मुफ्त में मिल सकती है)
DATABASE_URL = "mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
DATABASE_NAME = "tg_bot"

# --- Optional Settings (इन्हें खाली या डिफ़ॉल्ट छोड़ सकते हैं) ---
# लॉग चैनल आईडी (अगर कोई लॉग चैनल नहीं है तो 0 रखें)
LOG_CHANNEL = 0
# वेब सर्वर चालू करना है या नहीं (True/False)
WEB_SERVER = False
# थंबनेल इमेज के URL (स्पेस से अलग करके लिखें)
THUMBNAILS = ""
